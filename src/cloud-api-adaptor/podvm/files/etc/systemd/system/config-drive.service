[Unit]
Description=Mount config drive if present
Before=process-user-data.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/local/bin/process-user-data assert-config-drive
ExecStart=/usr/bin/mkdir -p /media/cidata
ExecStart=-/bin/bash -c 'for l in cidata config-2; do /usr/bin/udevadm wait --timeout=15 /dev/disk/by-label/$$l 2>/dev/null && /bin/mount -t auto -o ro /dev/disk/by-label/$$l /media/cidata && exit 0; done; echo "No config drive mounted (tried cidata, config-2)" >&2; exit 1'
ExecStop=/bin/umount /media/cidata
